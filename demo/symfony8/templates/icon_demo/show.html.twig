{% extends 'base.html.twig' %}

{% block title %}{{ ('demo.page_' ~ demo_slug ~ '_title')|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: ('demo.page_' ~ demo_slug ~ '_title')|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <a class="nowo-ui-back-link" href="{{ path('app_home', { _locale: app.request.locale }) }}">← {{ 'demo.back_home'|trans({}, 'messages') }}</a>
    <p class="nowo-ui-muted">{{ ('demo.page_' ~ demo_slug ~ '_lead')|trans({}, 'messages')|raw }}</p>

    {% if saved_value %}
        <div class="nowo-ui-flash nowo-ui-flash--info" role="status">
            <strong>{{ 'demo.saved_value'|trans({}, 'messages') }}</strong>
            {{ ux_icon(saved_value, { style: 'width:1.5rem;height:1.5rem;' }) }}
            <code class="nowo-ui-code">{{ saved_value }}</code>
        </div>
    {% endif %}

    <section class="nowo-ui-card" data-screenshot-target data-testid="demo-case">
        <div class="nowo-ui-card__body">
            {{ form_start(form) }}
                {# REQ-TWIG-003: child loop #}
                {% for child in form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form) }}
        </div>
    </section>

    <script src="{{ asset('icon-selector.js', 'nowo_icon_selector') }}"></script>
{% endblock %}
