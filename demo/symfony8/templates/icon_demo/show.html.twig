{% extends 'base.html.twig' %}

{% block title %}{{ ('demo.page_' ~ demo_slug ~ '_title')|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('app_home', { _locale: app.request.locale }) }}">{{ 'demo.back_home'|trans({}, 'messages') }}</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: ('demo.page_' ~ demo_slug ~ '_title')|trans({}, 'messages'),
        intro: ('demo.page_' ~ demo_slug ~ '_lead')|trans({}, 'messages')|striptags,
        toolbar: _toolbar|trim,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: ('demo.page_' ~ demo_slug ~ '_title')|trans({}, 'messages'), kind: 'form', testid: 'demo-case'} %}
        {% block section_body %}
            {{ form_start(form, { attr: { id: 'demo-form', class: 'nowo-ui-form' } }) }}
                {# REQ-TWIG-003: child loop #}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form, { render_rest: false }) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ 'demo.submit'|trans({}, 'messages') }}</button>
        {% endblock %}
    {% endembed %}

    {% if saved_value %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.saved_value'|trans({}, 'messages')|trim(':'), kind: 'detail', testid: 'demo-saved'} %}
            {% block section_body %}
                {# nowo_icon_selector_render(): icons through UX Icons + the SVG sanitizer, emoji:<grapheme> as escaped text. #}
                {{ nowo_icon_selector_render(saved_value, { width: 24, height: 24 }) }}
                <code class="nowo-ui-code">{{ saved_value }}</code>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}
