{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.page_title'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <p class="nowo-ui-muted">{{ 'demo.lead'|trans({}, 'messages')|raw }}</p>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <table class="nowo-ui-data-table">
                <tbody>
                    {% for item in [
                        { route: 'app_demo_grid', label: 'demo.label_icon_grid', lead: 'demo.page_grid_lead'|trans({}, 'messages') },
                        { route: 'app_demo_search', label: 'demo.label_icon_search', lead: 'demo.page_search_lead'|trans({}, 'messages') },
                        { route: 'app_demo_tom_select', label: 'demo.label_icon_tom_select', lead: 'demo.page_tom_select_lead'|trans({}, 'messages') },
                        { route: 'app_demo_heroicons', label: 'demo.label_icon_heroicons', lead: 'demo.page_heroicons_lead'|trans({}, 'messages') },
                        { route: 'app_demo_background', label: 'demo.page_background_title', lead: 'demo.page_background_lead'|trans({}, 'messages')|striptags|trim },
                    ] %}
                        <tr>
                            <td>
                                <a class="nowo-ui-link" href="{{ path(item.route, { _locale: app.request.locale }) }}">{{ item.label|trans({}, 'messages') }}</a>
                                <div class="nowo-ui-muted">{{ item.lead }}</div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
