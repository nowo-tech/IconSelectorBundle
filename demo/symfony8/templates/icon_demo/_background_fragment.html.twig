{# Fragment returned by GET /demo/background-fragment. Injected into the page via fetch(); the bundle's MutationObserver initializes the icon selector automatically. #}
<div class="icon-selector-background-fragment nowo-ui-card">
    <div class="nowo-ui-card__body">
        {{ form_start(form, { attr: { class: 'icon-selector-background-form' } }) }}
            {# REQ-TWIG-003: child loop #}
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
            <p class="nowo-ui-muted">{{ 'demo.background_fragment_loaded'|trans({}, 'messages') }}</p>
        {{ form_end(form) }}
    </div>
</div>
