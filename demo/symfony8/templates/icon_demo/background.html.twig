{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.page_background_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('app_home', { _locale: app.request.locale }) }}">{{ 'demo.back_home'|trans({}, 'messages') }}</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.page_background_title'|trans({}, 'messages'),
        intro: 'demo.page_background_lead'|trans({}, 'messages')|striptags,
        toolbar: _toolbar|trim,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.background_section'|trans({}, 'messages'), kind: 'content'} %}
        {% block section_actions %}
            <button type="button" class="nowo-ui-btn nowo-ui-btn--primary" id="demo-background-load-btn"
                data-fragment-url="{{ path('app_demo_background_fragment', { _locale: app.request.locale }) }}"
                data-label-loading="{{ 'demo.background_loading'|trans({}, 'messages') }}"
                data-label-again="{{ 'demo.background_load_again'|trans({}, 'messages') }}"
                data-label-error="{{ 'demo.background_error'|trans({}, 'messages') }}"
                data-label-load="{{ 'demo.background_load_button'|trans({}, 'messages') }}">
                {{ 'demo.background_load_button'|trans({}, 'messages') }}
            </button>
        {% endblock %}
        {% block section_body %}
            <div id="demo-background-container">
                <p class="nowo-ui-muted">{{ 'demo.background_placeholder'|trans({}, 'messages') }}</p>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('demo-background.js') }}"></script>
{% endblock %}
