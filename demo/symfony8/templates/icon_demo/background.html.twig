{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.page_background_title'|trans({}, 'messages') }} – {{ 'demo.title'|trans({}, 'messages') }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.page_background_title'|trans({}, 'messages'),
    }) }}
{% endblock %}

{% block body %}
    <a class="nowo-ui-back-link" href="{{ path('app_home', { _locale: app.request.locale }) }}">← {{ 'demo.back_home'|trans({}, 'messages') }}</a>
    <p class="nowo-ui-muted">{{ 'demo.page_background_lead'|trans({}, 'messages')|raw }}</p>

    <p>
        <button type="button" class="nowo-ui-btn nowo-ui-btn--primary" id="demo-background-load-btn" data-fragment-url="{{ path('app_demo_background_fragment', { _locale: app.request.locale }) }}">
            {{ 'demo.background_load_button'|trans({}, 'messages') }}
        </button>
    </p>

    <div id="demo-background-container" class="demo-background-container">
        <p class="nowo-ui-muted">{{ 'demo.background_placeholder'|trans({}, 'messages') }}</p>
    </div>

    <script src="{{ asset('icon-selector.js', 'nowo_icon_selector') }}"></script>
<script>
(function() {
    var btn = document.getElementById('demo-background-load-btn');
    var container = document.getElementById('demo-background-container');
    if (!btn || !container) return;
    btn.addEventListener('click', function() {
        btn.disabled = true;
        btn.textContent = '{{ 'demo.background_loading'|trans({}, 'messages') }}';
        fetch(btn.getAttribute('data-fragment-url'))
            .then(function(r) { return r.text(); })
            .then(function(html) {
                container.innerHTML = html;
                btn.disabled = false;
                btn.textContent = '{{ 'demo.background_load_again'|trans({}, 'messages') }}';
            })
            .catch(function() {
                container.innerHTML = '<p class="nowo-ui-flash nowo-ui-flash--error">{{ 'demo.background_error'|trans({}, 'messages') }}</p>';
                btn.disabled = false;
                btn.textContent = '{{ 'demo.background_load_button'|trans({}, 'messages') }}';
            });
    });
})();
</script>
{% endblock %}
