{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The icon widget's script is the IconSelectorBundle's own asset. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Icon Selector Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _locale = app.request.locale %}
    {% set _current_route = app.request.attributes.get('_route') ?? 'app_home' %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('app_home', { _locale: _locale }) }}">{{ 'demo.title'|trans({}, 'messages') }}</a>
        <nav class="nowo-ui-menu" aria-label="{{ 'demo.title'|trans({}, 'messages') }}">
            {% for item in [
                { route: 'app_home', label: 'demo.menu_home' },
                { route: 'app_demo_grid', label: 'demo.label_icon_grid' },
                { route: 'app_demo_search', label: 'demo.label_icon_search' },
                { route: 'app_demo_tom_select', label: 'demo.label_icon_tom_select' },
                { route: 'app_demo_heroicons', label: 'demo.label_icon_heroicons' },
                { route: 'app_demo_background', label: 'demo.page_background_title' },
            ] %}
                <a class="nowo-ui-link" href="{{ path(item.route, { _locale: _locale }) }}"{% if _current_route == item.route %} aria-current="page"{% endif %}>{{ item.label|trans({}, 'messages') }}</a>
            {% endfor %}
            {% for loc in ['en', 'es'] %}
                <a class="nowo-ui-link" href="{{ path(_current_route, { _locale: loc }) }}"{% if _locale == loc %} aria-current="true"{% endif %}>{{ loc|upper }}</a>
            {% endfor %}
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
