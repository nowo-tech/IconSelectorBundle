{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo. The icon
    widget's script is the IconSelectorBundle's own asset; its stylesheet is linked by the bundle's form theme. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _loc = app.request.locale %}
{% set nowo_ui_demo_platform = {
    bundle: 'Icon Selector',
    home_route: 'app_home',
    home_params: {_locale: _loc},
    repository: 'https://github.com/nowo-tech/IconSelectorBundle',
    translation_domain: 'messages',
    locales: ['en', 'es'],
    nav: [
        {label: 'demo.menu_home', route: 'app_home', params: {_locale: _loc}},
        {label: 'demo.label_icon_grid', route: 'app_demo_grid', params: {_locale: _loc}, section: 'demo.nav_modes'},
        {label: 'demo.label_icon_search', route: 'app_demo_search', params: {_locale: _loc}, section: 'demo.nav_modes'},
        {label: 'demo.label_icon_tom_select', route: 'app_demo_tom_select', params: {_locale: _loc}, section: 'demo.nav_modes'},
        {label: 'demo.label_icon_emoji', route: 'app_demo_emoji', params: {_locale: _loc}, section: 'demo.nav_modes'},
        {label: 'demo.label_icon_heroicons', route: 'app_demo_heroicons', params: {_locale: _loc}, section: 'demo.nav_modes'},
        {label: 'demo.page_background_title', route: 'app_demo_background', params: {_locale: _loc}, section: 'demo.nav_loading'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}{{ 'demo.title'|trans({}, 'messages') }}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('icon-selector.js', 'nowo_icon_selector') }}"></script>
{% endblock %}
