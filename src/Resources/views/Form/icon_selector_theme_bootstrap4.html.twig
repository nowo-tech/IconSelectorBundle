{#
  Form theme for IconSelectorType (Bootstrap 4 base).
#}
{% extends 'bootstrap_4_layout.html.twig' %}

{% block icon_selector_widget %}
{% set controllers = attr['data-controller']|default('')|split(' ')|filter(c => c is not empty) %}
{% set attr = attr|merge({
    'data-controller': ('icon-selector' in controllers ? controllers : controllers|merge(['icon-selector']))|join(' '),
    'data-icon-selector-mode-value': form.vars.mode|default('direct'),
    'data-icon-selector-icons-url-value': form.vars.icons_api_path|default('/api/icon-selector/icons'),
    class: ('icon-selector-widget' in (attr.class|default('')|split(' ')) ? attr.class : (attr.class|default('') ~ ' icon-selector-widget'))|trim,
}) %}
{# Wrapper id is suffixed so the field id stays unique (it belongs to the input targeted by the label). #}
<div id="{{ id }}_icon_selector"{{ block('attributes') }}>
    <input type="text"
           name="{{ full_name }}"
           id="{{ id }}"
           {% if value is not empty %}value="{{ value }}"{% endif %}
           {%- if disabled %} disabled="disabled"{% endif %}
           {%- if required %} required="required"{% endif %}
           data-icon-selector-target="input"
           autocomplete="off"
           class="icon-selector-input form-control" />
    <div data-icon-selector-target="picker" class="icon-selector-picker mt-2"></div>
</div>
{% endblock %}
